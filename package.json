  "main": "./dist/gateway/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:gateway": "OTEL_SERVICE_NAME=gateway PORT=3000 tsx watch --env-file-if-exists=.env --require ./src/shared/instrumentation.ts ./src/gateway/index.ts",
    "dev:docker-checker": "OTEL_SERVICE_NAME=docker-checker PORT=3001 tsx watch --env-file-if-exists=.env --require ./src/shared/instrumentation.ts ./src/docker-checker/index.ts",
    "build": "tsc",
    "start:gateway": "OTEL_SERVICE_NAME=gateway PORT=3000 node --env-file-if-exists=.env --require ./dist/shared/instrumentation.js ./dist/gateway/index.js",
    "start:docker-checker": "OTEL_SERVICE_NAME=docker-checker PORT=3001 node --env-file-if-exists=.env --require ./dist/shared/instrumentation.js ./dist/docker-checker/index.js"
  },
